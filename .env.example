# Google Cloud Configuration
PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
LOCATION_SCOPE=region-eu

# BigQuery Metadata Configuration
METADATA_DATASET_ID=metadata

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# OAuth Configuration (for web UI)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
SECRET_KEY=generate-a-random-secret-key-here
REDIRECT_URI=http://localhost:8081/auth/callback

# Domain Access Control (optional, comma-separated)
ALLOWED_DOMAINS=example.com,another-domain.com
